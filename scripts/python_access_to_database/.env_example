###############################################################################
# PostgreSQL (Timescale) via SSH tunnel
###############################################################################

# SSH tunnel
DB_SSH_HOST=
DB_SSH_PORT=22
DB_SSH_USER=
DB_SSH_PASS=

# Optional alternative to DB_SSH_PASS:
# DB_SSH_KEY=~/.ssh/id_ed25519
# DB_SSH_KEY_PASSPHRASE=

# Remote PostgreSQL or pgBouncer port on the server.
# Typical PostgreSQL: 5432
# Typical pgBouncer: 6432
DB_REMOTE_PORT=5432

# Local forwarding and database connection
DB_HOST=127.0.0.1
DB_PORT=6432

DB_DIALECT=postgresql
DB_NAME=opendata
DB_USER=opendata
DB_PASS=

# Optional timeout in seconds.
CONNECT_TIMEOUT=5
