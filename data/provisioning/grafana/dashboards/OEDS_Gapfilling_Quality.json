          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  r.finished_at AS time,\n  m.table_name || ' / ' || m.value_column AS metric,\n  SUM(m.filled_values)::double precision AS value\nFROM entsoe_fms_gapfilled.gapfill_metrics m\nJOIN entsoe_fms_gapfilled.gapfill_runs r ON r.run_id = m.run_id\nWHERE $__timeFilter(r.finished_at)\nGROUP BY 1, 2\nORDER BY 1, 2;",
          "refId": "A"
        }
      ],
