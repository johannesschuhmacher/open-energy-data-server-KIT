      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT forecast_time, weather_label, ROUND(temperature_2m_c::numeric, 1) AS temperature_c, ROUND(precipitation_mm::numeric, 2) AS precipitation_mm, ROUND(wind_speed_80m_ms::numeric, 1) AS wind_80m_ms, ROUND(shortwave_radiation_wm2::numeric, 0) AS shortwave_radiation_wm2 FROM weather.latest_hourly_forecast WHERE location_id = '$Location' AND forecast_time BETWEEN now() AND now() + interval '24 hours' ORDER BY forecast_time"
