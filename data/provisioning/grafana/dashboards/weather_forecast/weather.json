                }
              }
            }
          }
        ],
        "tooltip": { "mode": "details" },
        "view": { "id": "europe", "lat": 51, "lon": 10, "zoom": 4 }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Temperature Track",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "P6EAA63344BCC9F38"
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT forecast_time AS time, 'Temperature' AS metric, temperature_2m_c AS value FROM weather.latest_hourly_forecast WHERE location_id = '$Location' AND forecast_time BETWEEN to_timestamp($__from / 1000.0) AND to_timestamp($__to / 1000.0) UNION ALL SELECT forecast_time AS time, 'Apparent' AS metric, apparent_temperature_c AS value FROM weather.latest_hourly_forecast WHERE location_id = '$Location' AND forecast_time BETWEEN to_timestamp($__from / 1000.0) AND to_timestamp($__to / 1000.0) ORDER BY 1, 2"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
