    {
      "id": 5,
      "type": "geomap",
      "title": "Country Snapshot",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "P6EAA63344BCC9F38"
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH snapshot AS (SELECT COALESCE(MIN(CASE WHEN forecast_time >= now() - interval '1 hour' THEN forecast_time END), MAX(forecast_time)) AS forecast_time FROM weather.latest_hourly_forecast WHERE country_code = '$Country_Code') SELECT 0 AS time, latitude, longitude, location_name AS name, temperature_2m_c, wind_speed_10m_ms, wind_speed_80m_ms, shortwave_radiation_wm2, weather_label FROM weather.latest_hourly_forecast WHERE country_code = '$Country_Code' AND forecast_time = (SELECT forecast_time FROM snapshot) ORDER BY location_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlYlRd" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "wind_speed_10m_ms" },
            "properties": [
              { "id": "unit", "value": "velocityms" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "wind_speed_80m_ms" },
            "properties": [
              { "id": "unit", "value": "velocityms" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "shortwave_radiation_wm2" },
            "properties": [
              { "id": "unit", "value": "Wm2" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "temperature_2m_c" },
            "properties": [
              { "id": "unit", "value": "celsius" }
            ]
          }
        ]
      },
      "options": {
        "basemap": { "type": "default", "name": "Layer 0" },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showMeasure": false,
          "showScale": false,
          "showZoom": true
        },
        "layers": [
