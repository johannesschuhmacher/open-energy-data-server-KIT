FROM python:3.14.5-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.7 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libeccodes-dev && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock .python-version ./

RUN uv sync --locked --no-dev --no-install-project --group price-forecast

COPY crawler ./crawler
COPY crawler_admin ./crawler_admin
COPY oeds_price_forecast ./oeds_price_forecast
COPY scripts ./scripts
COPY crawler_scheduler.py ./crawler_scheduler.py
COPY crawler_admin_server.py ./crawler_admin_server.py
COPY CRAWLER_CONFIG.yml ./CRAWLER_CONFIG.yml

RUN useradd --create-home --shell /bin/bash oeds && \
    mkdir -p /app/logs /var/lib/oeds-admin && \
    chown -R oeds:oeds /app /var/lib/oeds-admin

USER oeds

CMD ["python", "crawler_scheduler.py"]
