# .env.example (This is only a template, please create an .env file in this directory)

# ---  ENTSOE account ---
ENTSOE_USERNAME="your_email@example.com"
ENTSOE_PASSWORD="your_secret_password"

# --- ENTSO-E Transparency Platform Web API token ---
# This is not the same secret as ENTSOE_USERNAME/ENTSOE_PASSWORD. The FMS
# crawler uses account login credentials; the Web API crawler uses a generated
# Transparency Platform security token. Leave it empty if you only use FMS.
ENTSOE_API_KEY="your_security_token"
# ENTSOE_SECURITY_TOKEN and ENTSOE_API are accepted as alternative variable names.

# --- Optional day-ahead price forecast upstream backend ---
# Defaults to auto: use DA_Price_Forecasting_Pipeline_DE_LU when importable,
# otherwise fall back to the OEDS ridge baseline.
# OEDS_PRICE_FORECAST_BACKEND="auto"
# OEDS_PRICE_FORECAST_MARKET_AREA="DE_LU"
# OEDS_PRICE_FORECAST_TRAIN_DAYS="56"
# OEDS_PRICE_FORECAST_BACKTEST_DAYS="2"
# OEDS_PRICE_FORECAST_RETENTION_DAYS="180"
# Optional local checkout override. Docker deployments install the pinned
# upstream package through the price-forecast dependency group.
# DA_PRICE_FORECASTING_REPO_PATH="C:/path/to/DA_Price_Forecasting_Pipeline_DE_LU"
# OEDS_PRICE_FORECAST_UPSTREAM_VARIANT="exaa_only"

# ---  Forecast token ---
ENERGY_FORECAST_TOKEN="your_token"

# --- EPEX SPOT SFTP account ---
EPEX_SFTP_USERNAME="your_marketdata_login"
EPEX_SFTP_PASSWORD="your_marketdata_password"
# EPEX_SFTP_HOST="sftp.marketdata.epexspot.com"
# EPEX_SFTP_PORT="22"
# Optional local override for manual runs without CRAWLER_CONFIG.yml.
# Prefer CRAWLER_CONFIG.yml for scheduled OEDS writes.
# EPEX_DATABASE_URI="postgresql://user:password@127.0.0.1:6432/opendata"

# --- Local email alert overrides ---
# Overrides default.email.toaddrs from CRAWLER_CONFIG.yml for local runs, scheduler,
# and admin-triggered test mails. Multiple recipients can be separated by commas.
OEDS_EMAIL_TOADDRS="ops@example.com"
# Optional overrides for the remaining default.email.* values in CRAWLER_CONFIG.yml.
# Keep these only in your unversioned local crawler/.env or host runtime env file.
# OEDS_EMAIL_MAILHOST="smtp.example.com"
# OEDS_EMAIL_FROMADDR="oeds@example.com"
# OEDS_EMAIL_SUBJECT="OEDS Crawler :crawler_name Critical Error Notification"
# OEDS_EMAIL_USERNAME="smtp-user"
# OEDS_EMAIL_PASSWORD="smtp-password"
